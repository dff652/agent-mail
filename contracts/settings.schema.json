{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-mail.dev/contracts/settings.schema.json",
  "title": "Agent Mail settings registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "settings"],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/setting"
      }
    }
  },
  "$defs": {
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "group",
        "type",
        "default",
        "authority",
        "mirrors",
        "scope",
        "danger",
        "writable",
        "cli",
        "summary",
        "since"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["integer", "enum", "object", "array", "bool", "string"]
        },
        "default": {},
        "minimum": {
          "type": "integer"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority": {
          "enum": ["config.json", "policy.yaml"]
        },
        "mirrors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["config.json", "policy.yaml"]
          }
        },
        "scope": {
          "const": "project"
        },
        "danger": {
          "enum": ["low", "medium", "high"]
        },
        "writable": {
          "type": "boolean"
        },
        "cli": {
          "type": "string",
          "pattern": "^agent-mail config (?:get|set|list)(?: |$)"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "integer"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["values"],
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
